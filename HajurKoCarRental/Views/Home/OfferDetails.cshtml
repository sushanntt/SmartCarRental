@using HajurKoCarRental.Models
@{
    ViewData["Title"] = "Offer Details";
}
@model Offer

<style>
    .detail-hero {
        background: linear-gradient(135deg, #0A4D3B 0%, #2D8A6E 100%);
        padding: 32px 0 28px;
    }
    .detail-hero h1 { color: #fff; font-weight: 700; font-size: 1.6rem; margin: 0; }
    .detail-hero p { color: rgba(255,255,255,0.65); margin: 4px 0 0; font-size: 0.9rem; }

    .detail-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 30px rgba(0,0,0,0.06);
        overflow: hidden;
    }
    .detail-card .img-section {
        position: relative;
        overflow: hidden;
        min-height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8faff;
    }
    .detail-card .img-section img {
        max-width: 100%;
        max-height: 420px;
        object-fit: contain;
        transition: transform 0.5s ease;
    }
    .detail-card .img-section .avail-badge-detail {
        position: absolute;
        top: 16px;
        left: 16px;
        padding: 6px 18px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
        z-index: 2;
    }
    .detail-card .img-section .avail-badge-detail.available {
        background: linear-gradient(135deg, #1cc88a, #13855c);
        color: #fff;
        box-shadow: 0 4px 15px rgba(28,200,138,0.3);
    }
    .detail-card .img-section .avail-badge-detail.unavailable {
        background: linear-gradient(135deg, #e74a3b, #be2617);
        color: #fff;
    }
    .detail-card .img-section .discount-badge-detail {
        position: absolute;
        top: 16px;
        right: 16px;
        background: linear-gradient(135deg, #ff6b35, #f7931e);
        color: #fff;
        padding: 6px 18px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(255,107,53,0.3);
        z-index: 2;
    }
    .detail-card .img-section .color-select-overlay { display: none; }
    .detail-card .img-section .color-select-overlay select { display: none; }

    .detail-card .info-section {
        padding: 32px;
    }
    .detail-card .info-section .car-title {
        font-size: 1.6rem;
        font-weight: 800;
        color: #0A4D3B;
        margin: 0 0 4px;
    }
    .detail-card .info-section .car-title small { font-weight: 400; color: #6b7a8f; font-size: 1rem; }

    .price-section {
        background: linear-gradient(135deg, #E8F5E9, #E8F5E9);
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }
    .price-section .price-left {
        display: flex;
        align-items: baseline;
        gap: 8px;
    }
    .price-section .price-left .current-price {
        font-size: 1.8rem;
        font-weight: 800;
        color: #0A4D3B;
    }
    .price-section .price-left .current-price small { font-size: 0.85rem; font-weight: 400; color: #6b7a8f; }
    .price-section .price-left .old-price {
        text-decoration: line-through;
        color: #bbb;
        font-size: 1rem;
    }
    .price-section .price-left .discount-label {
        font-size: 0.8rem;
        color: #ff6b35;
        font-weight: 600;
    }
    .price-section .status-badge {
        padding: 6px 18px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
    }
    .price-section .status-badge.avail { background: #d4edda; color: #155724; }
    .price-section .status-badge.unavail { background: #f8d7da; color: #721c24; }

    .desc-section {
        background: #fafbff;
        border-radius: 14px;
        padding: 18px 22px;
    }
    .desc-section h5 { font-weight: 700; color: #0A4D3B; font-size: 0.95rem; margin: 0 0 8px; }
    .desc-section p { color: #555; font-size: 0.9rem; line-height: 1.7; margin: 0; }

    .detail-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }
    .detail-actions .btn-rent-detail {
        flex: 1;
        background: linear-gradient(135deg, #0A4D3B, #063627);
        color: #fff;
        border: none;
        padding: 14px;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
    }
    .detail-actions .btn-rent-detail:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(64,112,244,0.3); color: #fff; }
    .detail-actions .btn-back-detail {
        flex: 1;
        background: #E8F5E9;
        color: #0A4D3B;
        border: 2px solid transparent;
        padding: 14px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        text-align: center;
        transition: all 0.3s ease;
    }
    .detail-actions .btn-back-detail:hover { background: #e4ebff; color: #063627; }
</style>

@{
    var discountAmount = (Model.Price * Model.DiscountPercentage) / 100;
    var amount = Model.Price - discountAmount;
    var isAvailable = Model.Available;
}

<div class="detail-hero">
    <div class="container">
        <a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,0.6);font-size:0.85rem;text-decoration:none;display:inline-block;margin-bottom:8px;"><i class="fa fa-arrow-left mr-1"></i> Back to Home</a>
        <h1><i class="fa fa-tag mr-2"></i>Offer Details</h1>
        <p>@Model.OfferTitle — @Model.CarName</p>
    </div>
</div>

<div class="container" style="margin-top: -20px; padding-bottom: 40px;">
    <div class="detail-card">
        <div class="row no-gutters">
            <div class="col-md-6">
                <div class="img-section">
                    @if (isAvailable)
                    {
                        <span class="avail-badge-detail available"><i class="fa fa-check-circle"></i> Available</span>
                    }
                    else
                    {
                        <span class="avail-badge-detail unavailable"><i class="fa fa-times-circle"></i> Unavailable</span>
                    }
                    <span class="discount-badge-detail"><i class="fa fa-fire"></i> @Model.DiscountPercentage% OFF</span>
                    <img src="~/images/@Model.PhotoUrl" alt="@Model.CarName" style="padding:20px;" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="info-section">
                    <h2 class="car-title">@Model.CarName <small>- @Model.OfferTitle</small></h2>

                    <div class="price-section">
                        <div class="price-left">
                            <span class="old-price">Rs. @Model.Price</span>
                            <span class="current-price">Rs. @amount <small>/ Day</small></span>
                            <span class="discount-label"><i class="fa fa-tag"></i> @Model.DiscountPercentage% off</span>
                        </div>
                        @if (isAvailable)
                        {
                            <span class="status-badge avail"><i class="fa fa-check-circle"></i> Available</span>
                        }
                        else
                        {
                            <span class="status-badge unavail"><i class="fa fa-times-circle"></i> Unavailable</span>
                        }
                    </div>

                    @if (Model.OfferBranches != null && Model.OfferBranches.Any())
                    {
                        <div class="desc-section mb-3">
                            <h5><i class="fa fa-building mr-1"></i> Available at Branches</h5>
                            @foreach (var ob in Model.OfferBranches)
                            {
                                <span class="badge" style="background:#E8F5E9;color:#0A4D3B;padding:6px 14px;margin:2px;font-weight:600;">
                                    @(ob.Branch?.Name ?? "Unknown") (@ob.AvailableCount)
                                </span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.OfferDescription))
                    {
                        <div class="desc-section">
                            <h5><i class="fa fa-align-left mr-1"></i> Description</h5>
                            <p>@Model.OfferDescription</p>
                        </div>
                    }

                    <div class="desc-section mt-3">
                        <h5><i class="fa fa-clock mr-1"></i> Offer Validity</h5>
                        <p>Valid until: @Model.ValidityPeroid.ToString("MMM dd, yyyy")</p>
                    </div>

                    <div class="detail-actions">
                        @if (isAvailable)
                        {
                            <a id="offerRentBtn" asp-controller="Home" asp-action="OfferCheck" asp-route-offerId="@Model.Id" class="btn-rent-detail"><i class="fa fa-shopping-cart"></i> Rent Now</a>
                        }
                        <a asp-controller="Home" asp-action="Index" class="btn-back-detail"><i class="fa fa-arrow-left"></i> Back to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
}
