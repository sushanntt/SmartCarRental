@using Microsoft.AspNetCore.Identity
@using HajurKoCarRental.Areas.Identity.Data
@using System.Security.Claims
@*@using static HajurKoCarRental.Controllers.HomeController*@

@inject SignInManager<HajurKoCarRentalUser> SignInManager
@inject UserManager<HajurKoCarRentalUser> UserManager
@*@inject HajurKoCarRental.Controllers.HomeController HomeC*@


<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a id="manage" class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                @if (User.Identity!.IsAuthenticated)
                {
                    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
                    var profilePic = "";

                    foreach (var user in UserManager.Users)
                    {
                        if (user.Id == userId)
                        {
                            profilePic = user.ProfilePhotoUrl;
                        }
                    }

                    if (!string.IsNullOrEmpty(profilePic))
                    {
                        <img src="~/images/@profilePic" alt="Profile Picture" class="rounded-circle mr-1" style="width: 40px; height: 40px;">
                    }
                    else
                    {
                        <i id="manage" class="nav-link text-dark fas fa-user" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage"></i>
                    }
                }
            </a>
        </li>
        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button id="logout" type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>
