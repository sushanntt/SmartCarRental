@model IEnumerable<HajurKoCarRental.Models.RentOffer>
@using System.Security.Claims

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    ViewData["Title"] = "Offer Rent Requests";
    <style>
        .badge {
            display: inline-block;
            padding: 0.25em 0.5em;
            font-size: 0.9em;
            font-weight: bold;
            line-height: 1;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            border-radius: 0.25rem;
            background-color: green;
            color: white;
        }
        .badge-pending {
            background-color: red;
        }
        .rental-table td, .rental-table th {
            white-space: nowrap;
        }
        .rental-table td img {
            width: 60px;
            height: 60px;
            object-fit: cover;
        }
    </style>
}

<div class="card">
    <div class="card-header">
        <h2>Offer Rental Requests</h2>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table rental-table">
                <thead>
                    <tr>
                        <th>Car Name</th>
                        <th>Car Photo</th>
                        <th>User</th>
                        <th>Phone No.</th>
                        <th>Pickup Branch</th>
                        <th>Payment Method</th>
                        <th>Total Amount</th>
                        <th>Advance Payment</th>
                        <th>Pay at Return</th>
                        <th>Duration</th>
                        <th>Verified Status</th>
                        <th>Rented Date</th>
                        <th>Operations</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="13" class="text-center py-4">
                                <i class="fa fa-inbox fa-3x text-muted mb-3"></i>
                                <p class="text-muted mb-0">No offer rental requests yet.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Offer?.CarName</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Offer?.PhotoUrl))
                                    {
                                        <img src="@Url.Content("~/images/" + item.Offer.PhotoUrl)" alt="Car" width="100" height="100" />
                                    }
                                </td>
                                <td>@item.User?.Email</td>
                                <td>@item.User?.PhoneNumber</td>
                                <td>@(item.PickupBranch?.Name ?? "-")</td>
                                <td>@item.PaymentMethod</td>
                                <td>Rs. @item.Amount</td>
                                <td>Rs. @item.AdvancePaid</td>
                                <td>
                                    @if (item.RemainingAmount > 0)
                                    {
                                        <span style="color:#e74a3b;font-weight:600;">Rs. @item.RemainingAmount</span>
                                    }
                                    else
                                    {
                                        <span style="color:#1cc88a;">Paid</span>
                                    }
                                </td>
                                <td>@item.Duration day(s)</td>
                                <td>
                                    @if (item.Verified == true)
                                    {
                                        <span class="badge">Approved</span>
                                    }
                                    else if (item.Verified == null)
                                    {
                                        <span class="badge" style="background-color: #6c757d;">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-pending">Pending</span>
                                    }
                                </td>
                                <td>@item.RentalDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <a class="btn btn-sm btn-info mb-1" asp-action="OfferRequestDetails" asp-route-id="@item.Id">Detail</a>

                                    @if (item.Verified == true)
                                    {
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="AdminRemoveApprovedOfferRent" asp-route-id="@item.Id" class="btn btn-sm btn-danger mb-1"
                                               onclick="return confirm('Remove this approved offer request?')">Remove</a>
                                            <a asp-action="ReturnOfferRent" asp-route-id="@item.Id" class="btn btn-sm btn-success mb-1"
                                               onclick="return confirm('Mark this offer car as returned?')">Return</a>
                                        }
                                    }
                                    else
                                    {
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="ApproveOfferCarRequest" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Approve</a>
                                            <a asp-action="RejectOfferCarRequest" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Reject</a>
                                        }
                                        else
                                        {
                                            <a asp-action="CustomerRemoveOfferRent" asp-route-id="@item.Id" class="btn btn-sm btn-warning mb-1"
                                               onclick="return confirm('Remove this pending offer request?')">Remove</a>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
