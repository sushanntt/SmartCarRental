@{
    ViewData["Title"] = "Chat";
    var customerId = ViewBag.CustomerId as string;
    var customerName = ViewBag.CustomerName as string;
    var customerPhoto = ViewBag.CustomerPhoto as string;
    var messages = ViewBag.Messages as IEnumerable<dynamic> ?? new List<dynamic>();
    var currentUserId = ViewBag.CurrentUserId as string;
}

<style>
    .chat-container { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; height: calc(100vh - 200px); }
    .chat-header { padding: 15px 20px; background: #343a40; color: white; border-radius: 8px 8px 0 0; display: flex; align-items: center; }
    .chat-header img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; margin-right: 12px; }
    .chat-messages { flex: 1; overflow-y: auto; padding: 20px; background: #f8f9fa; }
    .message { margin-bottom: 15px; display: flex; }
    .message.mine { justify-content: flex-end; }
    .message-bubble { max-width: 70%; padding: 10px 15px; border-radius: 18px; word-wrap: break-word; }
    .message.mine .message-bubble { background: #0A4D3B; color: white; border-bottom-right-radius: 4px; }
    .message.theirs .message-bubble { background: white; border: 1px solid #dee2e6; border-bottom-left-radius: 4px; }
    .message-time { font-size: 11px; color: #999; margin-top: 4px; padding: 0 5px; }
    .chat-input { display: flex; padding: 15px; background: white; border: 1px solid #dee2e6; border-radius: 0 0 8px 8px; }
    .chat-input input { flex: 1; padding: 10px 15px; border: 1px solid #dee2e6; border-radius: 20px; outline: none; margin-right: 10px; }
    .chat-input button { border-radius: 20px; padding: 10px 25px; }
</style>

<div class="container mt-4">
    <div class="chat-container">
        <div class="chat-header">
            @if (!string.IsNullOrEmpty(customerPhoto))
            {
                <img src="~/images/@customerPhoto" alt="" />
            }
            else
            {
                <div style="width:40px;height:40px;border-radius:50%;background:#6c757d;display:flex;align-items:center;justify-content:center;color:white;font-weight:bold;margin-right:12px;">@(customerName?.FirstOrDefault() ?? '?')</div>
            }
            <h5 class="mb-0">@customerName</h5>
        </div>

        <div class="chat-messages" id="chatMessages">
            @foreach (var msg in messages)
            {
                <div class="message @(msg.IsMine ? "mine" : "theirs")">
                    <div class="message-bubble">
                        @msg.Message
                        <div class="message-time" style="color:@(msg.IsMine ? "rgba(255,255,255,0.7)" : "#999")">
                            @msg.SentAt.ToLocalTime().ToString("MMM dd, HH:mm")
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="chat-input">
            <input type="text" id="messageInput" placeholder="Type a message..." onkeypress="if(event.key==='Enter') sendMessage()" />
            <button class="btn btn-primary" onclick="sendMessage()">Send</button>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.15/signalr.min.js"></script>
<script>
    const customerId = '@customerId';
    const currentUserId = '@currentUserId';

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/chatHub")
        .withAutomaticReconnect()
        .build();

    connection.on("ReceiveMessage", function (senderId, message, sentAt) {
        const isMine = senderId === currentUserId;
        addMessage(message, sentAt, isMine);
    });

    connection.start().catch(err => console.error(err));

    function sendMessage() {
        const input = document.getElementById('messageInput');
        const msg = input.value.trim();
        if (!msg) return;

        // Add message immediately (optimistic)
        addMessage(msg, new Date().toISOString(), true);

        connection.invoke("SendMessage", customerId, msg).catch(err => {
            console.error(err);
        });

        input.value = '';
    }

    function addMessage(text, sentAt, isMine) {
        const container = document.getElementById('chatMessages');
        const div = document.createElement('div');
        div.className = 'message ' + (isMine ? 'mine' : 'theirs');
        const time = sentAt ? new Date(sentAt).toLocaleString('en-US', { month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' }) : '';
        div.innerHTML = '<div class="message-bubble">' + escapeHtml(text) +
            '<div class="message-time" style="color:' + (isMine ? 'rgba(255,255,255,0.7)' : '#999') + '">' + time + '</div></div>';
        container.appendChild(div);
        container.scrollTop = container.scrollHeight;
    }

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    // Scroll to bottom on load
    document.getElementById('chatMessages').scrollTop = document.getElementById('chatMessages').scrollHeight;
</script>
