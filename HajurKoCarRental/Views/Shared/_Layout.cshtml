    <script src="//cdn.jsdelivr.net/npm/alertifyjs@1.13.1/build/alertify.min.js"></script>


    @if (TempData["SuccessMessage"] != null)
    {
        var successMsg = TempData["SuccessMessage"].ToString().Replace("\\", "\\\\").Replace("\"", "\\\"");
        <script>
            alertify.set('notifier', 'position', 'top-right');
            alertify.success("@successMsg");
        </script>

    }

    @if (TempData["ErrorMessage"] != null)
    {
        var errorMsg = TempData["ErrorMessage"].ToString().Replace("\\", "\\\\").Replace("\"", "\\\"");
        <script>
            alertify.set('notifier', 'position', 'top-right');
            alertify.error("@errorMsg");
        </script>

    }

    @if (TempData["WarningMessage"] != null)
    {
        var warningMsg = TempData["WarningMessage"].ToString().Replace("\\", "\\\\").Replace("\"", "\\\"");
        <script>
            alertify.set('notifier', 'position', 'top-right');
            alertify.warning("@warningMsg");
        </script>

    }
    <script>
        let sidebar = document.querySelector(".sidebar");
        let sidebarBtn = document.querySelector(".sidebarBtn");
        if (sidebarBtn) {
            sidebarBtn.onclick = function () {
                sidebar.classList.toggle("active");
                if (sidebar.classList.contains("active")) {
                    sidebarBtn.classList.replace("bx-menu", "bx-menu-alt-right");
                } else
                    sidebarBtn.classList.replace("bx-menu-alt-right", "bx-menu");
            }
        }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_ChatWidget")

    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
    {
        var isChatPage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Chat", StringComparison.OrdinalIgnoreCase);
        if (!isChatPage)
        {
            var adminId = _userManager.GetUserId(User);
            <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.15/signalr.min.js"></script>
            <script>
                (function() {
                    const adminId = '@adminId';
                    const conn = new signalR.HubConnectionBuilder()
                        .withUrl("/chatHub")
                        .withAutomaticReconnect()
                        .build();

                    conn.on("ReceiveMessage", function (senderId) {
                        if (senderId !== adminId) {
                            const wrap = document.getElementById('chatSidebarBadgeWrap');
                            if (wrap) {
                                let badge = wrap.querySelector('span');
                                if (!badge) {
                                    badge = document.createElement('span');
                                    badge.style.cssText = 'position:absolute;right:15px;top:50%;transform:translateY(-50%);background-color:#ff3333;color:white;border-radius:50%;width:20px;height:20px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:bold;padding:0;line-height:1;z-index:100;';
                                    wrap.appendChild(badge);
                                }
                                let count = parseInt(badge.textContent) || 0;
                                count++;
                                badge.textContent = count;
                                badge.style.display = 'flex';
                            }
                        }
                    });

                    conn.start().catch(function () {});
                })();
            </script>
        }
    }
</body>
</html>



