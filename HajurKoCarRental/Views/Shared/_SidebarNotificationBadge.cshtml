@model int
@if (Model > 0)
{
    <span style="position: absolute; right: 15px; top: 50%; transform: translateY(-50%); background-color: #ff3333; color: white; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; padding: 0; line-height: 1; z-index: 100;">@Model</span>
}
