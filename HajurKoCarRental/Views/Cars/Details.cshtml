@model HajurKoCarRental.Models.Car

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Car</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ModelName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ModelName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CarBrand)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CarBrand.BrandName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ModelYear)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ModelYear)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TotalSeats)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TotalSeats) seats
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EngineType)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EngineType)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class="col-sm-10">
            Rs. @Html.DisplayFor(model => model.Price)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PhotoUrl)
        </dt>
        <dd class = "col-sm-10">
            <img src="@Url.Content("~/images/" + @Model.PhotoUrl)" alt="Image" width="100" height="100" />
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Available)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Available)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AvailableCarCount)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AvailableCarCount)
        </dd>
        <dt class="col-sm-2">
            Branches
        </dt>
        <dd class="col-sm-10">
            @if (Model.CarBranches != null && Model.CarBranches.Any())
            {
                <ul class="mb-0">
                    @foreach (var cb in Model.CarBranches)
                    {
                        <li>@(cb.Branch?.Name ?? "Unknown") — @cb.AvailableCount available</li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">No branch assignment</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-primary">Edit</a> |
    <a asp-action="Index" class="btn btn-outline-danger">Back to List</a>
</div>
