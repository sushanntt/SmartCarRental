@using HajurKoCarRental.Areas.Identity.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<HajurKoCarRentalUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@model List<HajurKoCarRentalUser>

@{
    ViewData["Title"] = "Inactive Customers";
}
<h1>Inactive Customers</h1>
<br />
<table class="table">
    <thead>
        <tr>
            <th>
                User ID
            </th>
            <th>
                Photo
            </th>
            <th>
                User Name
            </th>
            <th>
                Address
            </th>
            <th>
                Phone Number
            </th>
            <th>
                Email
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var roles = await UserManager.GetRolesAsync(item);
            if (roles.Contains("Customer"))
            {
                if (@item.RegularCustomer == null || @item.RegularCustomer == false)
                {
                    <tr>

                        <td>
                            @item.Id
                        </td>
                        <td>
                            @if (item.ProfilePhotoUrl != null)
                            {
                                <img src="@Url.Content("~/images/" + @item.ProfilePhotoUrl)" width="100" height="100" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/images/no-photos.png")" width="100" height="100" />
                            }

                        </td>
                        <td>
                            @item.Firstname @item.Lastname
                        </td>
                        <td>
                            @item.Address
                        </td>
                        <td>
                            @(item.PhoneNumber)
                        </td>
                        <td>
                            @item.Email
                        </td>


                    </tr>
                }
            }
        }
    </tbody>
</table>
