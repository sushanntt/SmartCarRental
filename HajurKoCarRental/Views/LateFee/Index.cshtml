@model IEnumerable<HajurKoCarRental.Models.LateFee>

@{
    ViewData["Title"] = "Late Fees";
}

<h1>Late Fee Management</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Email</th>
            <th>Car Model</th>
            <th>Amount</th>
            <th>Hours Late</th>
            <th>Status</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted py-4">
                    <i class="fa fa-check-circle fa-2x text-muted mb-2"></i><br/>
                    No late fees found.
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.User?.Firstname @item.User?.Lastname</td>
                    <td>@item.User?.Email</td>
                    <td>@(item.Car?.ModelName ?? "-")</td>
                    <td>Rs. @item.Amount</td>
                    <td>
                        @{
                            var lateDays = (int)(item.HoursLate / 24);
                            var lateHours = (int)(item.HoursLate % 24);
                            if (lateDays > 0)
                            {
                                <text>@lateDays days, @lateHours hrs</text>
                            }
                            else
                            {
                                <text>@lateHours hrs</text>
                            }
                        }
                    </td>
                    <td>
                        @if (item.Status == "Unpaid")
                        {
                            <span class="badge" style="background-color:red;color:white;">Unpaid</span>
                        }
                        else
                        {
                            <span class="badge" style="background-color:green;color:white;">Paid</span>
                        }
                    </td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        }
    </tbody>
</table>
