@{
    ViewData["Title"] = "About Us";
}

<style>
    .about-hero {
        background: linear-gradient(135deg, #0A4D3B 0%, #2D8A6E 60%, #6EC4A8 100%);
        padding: 80px 0 60px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .about-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle at 30% 50%, rgba(255,215,0,0.08) 0%, transparent 50%),
                    radial-gradient(circle at 70% 50%, rgba(255,255,255,0.05) 0%, transparent 50%);
        animation: heroGlow 8s ease-in-out infinite alternate;
    }
    @@keyframes heroGlow {
        0% { transform: translate(0, 0); }
        100% { transform: translate(-20px, 20px); }
    }
    .about-hero .section-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.15);
        color: #fff;
        padding: 8px 24px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 20px;
        position: relative;
        z-index: 1;
    }
    .about-hero h1 {
        color: #fff;
        font-size: 3.2rem;
        font-weight: 800;
        margin-bottom: 16px;
        position: relative;
        z-index: 1;
    }
    .about-hero h1 span {
        background: linear-gradient(135deg, #ffd700, #ff8c00);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .about-hero p {
        color: rgba(255,255,255,0.85);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
    }

    .about-section {
        padding: 80px 0;
    }
    .about-section:nth-child(even) {
        background: #f8faff;
    }

    .detail-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        overflow: hidden;
        height: 100%;
    }
    .detail-card .card-body {
        padding: 40px;
    }
    .detail-card .card-body .section-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #E8F5E9;
        color: #0A4D3B;
        padding: 6px 20px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 16px;
    }
    .detail-card .card-body h2 {
        font-size: 2rem;
        font-weight: 800;
        color: #0A4D3B;
        margin-bottom: 16px;
    }
    .detail-card .card-body p {
        color: #555;
        font-size: 1rem;
        line-height: 1.8;
        margin-bottom: 12px;
    }
    .detail-card .card-body .about-list {
        list-style: none;
        padding: 0;
        margin: 20px 0;
    }
    .detail-card .card-body .about-list li {
        padding: 8px 0;
        color: #555;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .detail-card .card-body .about-list li i {
        width: 28px;
        height: 28px;
        background: linear-gradient(135deg, #0A4D3B, #063627);
        color: #fff;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        flex-shrink: 0;
    }
    .detail-card .image-wrapper {
        height: 100%;
        min-height: 400px;
        overflow: hidden;
    }
    .detail-card .image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    .detail-card:hover .image-wrapper img {
        transform: scale(1.05);
    }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 24px;
        margin-top: 40px;
    }
    .value-card {
        background: #fff;
        border-radius: 20px;
        padding: 36px 24px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        transition: all 0.3s ease;
        border: 1px solid rgba(64,112,244,0.08);
    }
    .value-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 40px rgba(0,0,0,0.1);
        border-color: rgba(64,112,244,0.2);
    }
    .value-card .value-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 20px;
        background: linear-gradient(135deg, #E8F5E9, #d0e0ff);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: #0A4D3B;
        transition: all 0.3s ease;
    }
    .value-card:hover .value-icon {
        background: linear-gradient(135deg, #0A4D3B, #063627);
        color: #fff;
    }
    .value-card h4 {
        font-size: 1.15rem;
        font-weight: 700;
        color: #0A4D3B;
        margin-bottom: 12px;
    }
    .value-card p {
        font-size: 0.9rem;
        color: #6b7a8f;
        line-height: 1.6;
        margin: 0;
    }

    .cta-banner {
        background: linear-gradient(135deg, #0A4D3B 0%, #2D8A6E 60%, #6EC4A8 100%);
        border-radius: 20px;
        padding: 60px 40px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .cta-banner::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(255,215,0,0.08) 0%, transparent 70%);
        border-radius: 50%;
    }
    .cta-banner h2 {
        color: #fff;
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 12px;
        position: relative;
        z-index: 1;
    }
    .cta-banner p {
        color: rgba(255,255,255,0.85);
        font-size: 1.05rem;
        max-width: 500px;
        margin: 0 auto 24px;
        position: relative;
        z-index: 1;
    }
    .cta-banner .btn-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #ffd700, #ff8c00);
        color: #0A4D3B;
        padding: 14px 40px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        transition: all 0.3s ease;
        position: relative;
        z-index: 1;
        border: none;
    }
    .cta-banner .btn-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(255,215,0,0.3);
        color: #0A4D3B;
    }

    .section-header-center {
        text-align: center;
        margin-bottom: 40px;
    }
    .section-header-center .section-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #E8F5E9;
        color: #0A4D3B;
        padding: 6px 20px;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 12px;
    }
    .section-header-center h2 {
        font-size: 2.2rem;
        font-weight: 800;
        color: #0A4D3B;
        margin-bottom: 8px;
    }
    .section-header-center p {
        color: #6b7a8f;
        font-size: 1rem;
        max-width: 500px;
        margin: 0 auto;
    }

    @@media (max-width: 768px) {
        .about-hero h1 { font-size: 2.2rem; }
        .detail-card .card-body { padding: 24px; }
        .detail-card .card-body h2 { font-size: 1.5rem; }
        .detail-card .image-wrapper { min-height: 250px; }
        .stat-item .stat-number { font-size: 2rem; }
        .values-grid { grid-template-columns: 1fr; }
        .cta-banner { padding: 40px 24px; }
        .cta-banner h2 { font-size: 1.5rem; }
    }
</style>

<!-- Hero -->
<section class="about-hero">
    <div class="container">
        <div class="section-tag"><i class="fas fa-info-circle"></i> About Us</div>
        <h1>Your Trusted <span>Car Rental</span> Partner</h1>
        <p>Smart Car Rental System is Nepal's trusted car rental service, delivering quality vehicles and seamless booking experiences across multiple locations.</p>
    </div>
</section>

<!-- Our Story -->
<section class="about-section">
    <div class="container">
        <div class="detail-card">
            <div class="row g-0">
                <div class="col-md-6">
                    <div class="image-wrapper">
                        <img src="https://images.unsplash.com/photo-1550355291-bbee04a92027?w=800&q=80" alt="Smart Car Rental fleet">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card-body">
                        <div class="section-tag"><i class="fas fa-book-open"></i> Our Story</div>
                        <h2>Reliable Rides, Every Time</h2>
                        <p>Smart Car Rental System is a trusted car rental service based in Lalitpur, Nepal. We offer a wide range of well-maintained vehicles at affordable prices, making it easy for you to find the perfect car for every occasion — whether it's a weekend getaway, a business trip, or daily commuting.</p>
                        <p>Our platform provides a seamless online booking experience with secure payment options including Khalti, transparent pricing, and dedicated customer support. At Smart Car Rental, we believe in delivering quality, convenience, and reliability on every ride.</p>
                        <ul class="about-list">
                            <li><i class="fas fa-check"></i> Wide range of well-maintained vehicles</li>
                            <li><i class="fas fa-check"></i> Secure online booking with Khalti payment</li>
                            <li><i class="fas fa-check"></i> Transparent pricing with no hidden charges</li>
                            <li><i class="fas fa-check"></i> 24/7 dedicated customer support</li>
                        </ul>
                        <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Contact" style="border-radius: 10px; padding: 12px 32px; font-weight: 600; background: linear-gradient(135deg, #0A4D3B, #063627); border: none;">
                            <i class="fas fa-headset"></i> Get in Touch
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Our Values -->
<section class="about-section">
    <div class="container">
        <div class="section-header-center">
            <div class="section-tag"><i class="fas fa-heart"></i> Our Values</div>
            <h2>What Drives Us</h2>
            <p>Our core values shape every ride and every interaction with our customers.</p>
        </div>
        <div class="values-grid">
            <div class="value-card">
                <div class="value-icon"><i class="fas fa-shield-alt"></i></div>
                <h4>Safety First</h4>
                <p>Every vehicle undergoes rigorous inspection and maintenance to ensure your safety on every journey.</p>
            </div>
            <div class="value-card">
                <div class="value-icon"><i class="fas fa-hand-holding-usd"></i></div>
                <h4>Affordable Pricing</h4>
                <p>We offer competitive rates with complete transparency — no hidden fees, no surprises, just fair prices.</p>
            </div>
            <div class="value-card">
                <div class="value-icon"><i class="fas fa-clock"></i></div>
                <h4>24/7 Support</h4>
                <p>Our dedicated support team is available around the clock to assist you with bookings and roadside help.</p>
            </div>
            <div class="value-card">
                <div class="value-icon"><i class="fas fa-thumbs-up"></i></div>
                <h4>Customer First</h4>
                <p>We prioritize your satisfaction with flexible bookings, easy returns, and personalized service.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="about-section" style="padding-top: 0;">
    <div class="container">
        <div class="cta-banner">
            <h2>Ready to Hit the Road?</h2>
            <p>Browse our wide selection of vehicles and book your perfect ride in minutes.</p>
            <a class="btn-cta" asp-area="" asp-controller="Home" asp-action="CarList">
                <i class="fas fa-car"></i> Explore Our Fleet
            </a>
        </div>
    </div>
</section>
