@section Scripts {
    <script>
        function filterByBrand(brandId) {
            if (brandId) {
                window.location.href = '@Url.Action("FilterCarList", "Home")?brandId=' + brandId;
            } else {
                window.location.href = '@Url.Action("Index", "Home")';
            }
        }
        let currentSlide = 0;
        const track = document.getElementById('carSlideTrack');
        const dotsContainer = document.getElementById('sliderDots');
        if (track) {
            const slides = track.querySelectorAll('.car-slide-item');
            slides.forEach((_, i) => {
                const dot = document.createElement('button');
                dot.className = 'slider-dot' + (i === 0 ? ' active' : '');
                dot.onclick = () => goToSlide(i);
                dotsContainer.appendChild(dot);
            });
            function goToSlide(n) {
                currentSlide = n;
                if (n >= slides.length) currentSlide = 0;
                if (n < 0) currentSlide = slides.length - 1;
                track.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
                dotsContainer.querySelectorAll('.slider-dot').forEach((d, i) => {
                    d.classList.toggle('active', i === currentSlide);
                });
            }
            window.moveSlide = (n) => goToSlide(currentSlide + n);
            setInterval(() => goToSlide(currentSlide + 1), 5000);
        }
    </script>

    @if (carsByBrand.Count > 0)
    {
        var datasetsJson = string.Join(",", carsByBrand.Select(b => $"{{label: '{b.BrandName}', data: [{b.CarCount}], borderWidth: 1}}"));
        <script>
            var ctx = document.getElementById('myChart').getContext('2d');
            var carChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Car Count'],
                    datasets: [@Html.Raw(datasetsJson)]
                },
                options: {
                    scales: {
                        yAxes: [{
                            ticks: {
                                beginAtZero: true
                            }
                        }]
                    }
                }
            });
        </script>
    }

    @if (SignInManager.IsSignedIn(User) && User.IsInRole("Customer") && Model.AvailableCarsByBrand != null && Model.AvailableCarsByBrand.Count > 0)
    {
        <script>
            var ctx2 = document.getElementById('customerChart').getContext('2d');
            var customerChart = new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: [@Html.Raw(string.Join(",", Model.AvailableCarsByBrand.Select(b => $"'{((dynamic)b).BrandName}'")))],
                    datasets: [{
                        label: 'Available Cars by Brand',
                        data: [@Html.Raw(string.Join(",", Model.AvailableCarsByBrand.Select(b => ((dynamic)b).CarCount)))],
                        backgroundColor: 'rgba(54, 162, 235, 0.5)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });
        </script>
    }
}
