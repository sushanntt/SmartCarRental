@model List<HajurKoCarRental.Models.Car>
@{
    ViewData["Title"] = "Compare Cars";
    var multiplier = ViewBag.FestivalMultiplier ?? 1.0m;
    var minPrice = Model.Min(c => (int)Math.Round(c.Price * (double)multiplier));
}

<style>
    .compare-wrapper { max-width: 1200px; margin: 0 auto; }
    .compare-header { text-align: center; padding: 30px 0 20px; }
    .compare-header h2 { font-weight: 700; }
    .compare-header p { color: #6c757d; }
    .compare-grid { display: grid; grid-template-columns: 180px repeat(@Model.Count, 1fr); gap: 0; border: 1px solid #dee2e6; border-radius: 12px; overflow: hidden; background: #fff; }
    .compare-label { padding: 16px 18px; background: #f8f9fa; font-weight: 600; font-size: 14px; color: #495057; display: flex; align-items: center; border-bottom: 1px solid #dee2e6; border-right: 1px solid #dee2e6; }
    .compare-cell { padding: 16px 18px; border-bottom: 1px solid #dee2e6; text-align: center; font-size: 14px; display: flex; align-items: center; justify-content: center; flex-direction: column; }
    .compare-cell:not(:last-child) { border-right: 1px solid #dee2e6; }
    .compare-row-img .compare-cell { padding: 0; }
    .compare-img { width: 100%; height: 180px; object-fit: cover; display: block; }
    .compare-car-name { font-size: 18px; font-weight: 700; margin-top: 8px; color: #212529; }
    .compare-car-brand { font-size: 13px; color: #6c757d; margin-top: 2px; }
    .compare-price { font-size: 22px; font-weight: 700; color: #dc3545; }
    .compare-price .per-day { font-size: 13px; font-weight: 400; color: #6c757d; }
    .compare-price.best { color: #198754; }
    .compare-price.best::after { content: " Best Price"; display: block; font-size: 11px; font-weight: 600; color: #198754; margin-top: 2px; }
    .compare-badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 12px; font-weight: 500; }
    .compare-badge.available { background: #d1e7dd; color: #0f5132; }
    .compare-badge.booked { background: #f8d7da; color: #842029; }
    .compare-btn { margin-top: 8px; }
    .back-link { display: inline-flex; align-items: center; gap: 6px; color: #6c757d; text-decoration: none; margin-bottom: 20px; font-size: 14px; }
    .back-link:hover { color: #212529; }
    .compare-empty { text-align: center; padding: 16px; color: #adb5bd; font-style: italic; }
    @@media (max-width: 768px) {
        .compare-grid { grid-template-columns: 110px repeat(@Model.Count, 1fr); }
        .compare-label { padding: 12px 10px; font-size: 12px; }
        .compare-cell { padding: 12px 10px; font-size: 12px; }
        .compare-img { height: 120px; }
        .compare-car-name { font-size: 15px; }
        .compare-price { font-size: 18px; }
    }
</style>

<div class="container mt-4 compare-wrapper">
    <a href="javascript:history.back()" class="back-link">&larr; Back to Car List</a>

    <div class="compare-header">
        <h2><i class="fas fa-balance-scale me-2"></i>Compare Cars</h2>
    </div>

    <div class="compare-grid">
        <div class="compare-label">Photo</div>
        @foreach (var car in Model)
        {
            var displayPrice = (int)Math.Round(car.Price * (double)multiplier);
            var isBest = displayPrice == minPrice;
            <div class="compare-cell compare-row-img">
                <img src="~/images/@car.PhotoUrl" class="compare-img" alt="@car.ModelName" onerror="this.style.display='none'" />
                <div class="compare-car-name">@car.ModelName</div>
                <div class="compare-car-brand">@car.CarBrand?.BrandName</div>
            </div>
        }

        @{ var rows = new (string label, Func<HajurKoCarRental.Models.Car, object> value)[]
            {
                ("Brand", c => c.CarBrand?.BrandName ?? "-"),
                ("Model Year", c => c.ModelYear),
                ("Seats", c => c.TotalSeats),
                ("Engine", c => c.EngineType ?? "-"),
                ("Plate Number", c => c.CarNumber ?? "-"),
                ("Status", c => (c.IsCarBooked == true ? "Booked" : (c.Available ? "Available" : "Unavailable")) as object),
                ("Available Units", c => c.AvailableCarCount),
                ("Description", c => c.CarDescription ?? "-")
            };
        }

        @foreach (var row in rows)
        {
            <div class="compare-label">@row.label</div>
            @foreach (var car in Model)
            {
                var val = row.value(car)?.ToString() ?? "-";
                <div class="compare-cell">@val</div>
            }
        }

        <div class="compare-label">Price / Day</div>
        @foreach (var car in Model)
        {
            var displayPrice = (int)Math.Round(car.Price * (double)multiplier);
            var isBest = displayPrice == minPrice;
            <div class="compare-cell">
                <div class="compare-price @(isBest ? "best" : "")">Rs. @displayPrice <span class="per-day">/ Day</span></div>
            </div>
        }

        <div class="compare-label">Action</div>
        @foreach (var car in Model)
        {
            <div class="compare-cell">
                <a asp-action="BeforeKhalti" asp-route-carId="@car.Id" class="btn btn-primary btn-sm compare-btn">Rent Now</a>
                <a asp-action="CarDetails" asp-route-id="@car.Id" class="btn btn-outline-secondary btn-sm compare-btn mt-1">View Details</a>
            </div>
        }
    </div>

    <div class="text-center mt-4 mb-5">
        <a href="javascript:history.back()" class="btn btn-outline-secondary">&larr; Back to Car List</a>
    </div>
</div>
